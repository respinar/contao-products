{% use "@Contao/component/_figure.html.twig" %}

<div class="product-full {{ class }}">

    <h1>{{ title }}</h1>

    <div class="product-full__meta">
        <div class="product-full__info">
            <time datetime="{{ meta.datetime }}">{{ meta.date }}</time>

            {% if brand %}
                <span class="product-full__brand">{{ brand_text }}: <span>{{ brand }}</span></span>
            {% endif %}

            {% if model %}
                <span class="product-full__model">{{ model_text }}: <span>{{ model }}</span></span>
            {% endif %}

            {% if sku %}
                <span class="product-full__sku">{{ sku_text }}: <span>{{ sku }}</span></span>
            {% endif %}

            {% if meta.global_ID is defined %}
                <span class="product-full__global-id {{ meta.global_ID.unit }}">
                    {{ meta.global_ID.name }}:
                    <span>{{ meta.global_ID.value }}</span>
                </span>
            {% endif %}
        </div>

        <div class="product-full__offer">
            {% if meta.price is defined and meta.price is iterable %}
                {{ meta.price_text }}:
                <span>{{ meta.price.value|number_format }}</span>
                <span>{{ meta.price.symbol }}</span>
            {% endif %}

            {% if meta.availability is defined %}
                <span class="product-full__availability {{ meta.availability.class }}">
                    ({{ meta.availability.value }})
                </span>
            {% endif %}

            {% if url %}
                <span class="product-full__buy">
                    <a href="{{ url|insert_tag }}"
                        class="product-full__buy-link"
                        title="{{ linkTitle }}"
                        {% if target %}target="_blank" rel="nofollow"{% endif %}>
                        {{ titleText ?: url|insert_tag }}
                    </a>
                </span>
            {% endif %}
        </div>
    </div>

    {% if hasSummary %}
        <div class="product-full__summary">

            {{ summary|raw }}

            {% if figure %}
                {% if link %}<a href="{{ link }}">{% endif %}
                {% with {figure: figure} %}
                    {{ block('figure_component') }}
                {% endwith %}
                {% if link %}</a>{% endif %}
            {% endif %}

        </div>
    {% endif %}

    {% if hasText %}
        {{ text|raw }}
    {% endif %}

    {% if hasEnclosure %}
        <div class="product-full__enclosure">
            {% for enclosure in enclosure %}
                <p>
                    <img src="{{ enclosure.icon }}"
                         width="18"
                         height="18"
                         alt="{{ enclosure.mime }}"
                         class="product-full__mime-icon">

                    <a href="{{ enclosure.href }}" title="{{ enclosure.title }}">
                        {{ enclosure.link }}
                        <span class="product-full__size">({{ enclosure.filesize }})</span>
                    </a>
                </p>
            {% endfor %}
        </div>
    {% endif %}

</div>

{% do add_schema_org(schemaOrgData) %}
