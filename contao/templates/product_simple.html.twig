{% use "@Contao/component/_figure.html.twig" %}

<div class="product-simple {{ class }}">

    {% if figure %}
        {% if link %}<a href="{{ link }}">{% endif %}
        {% with {figure: figure} %}
            {{ block('figure_component') }}
        {% endwith %}
        {% if link %}</a>{% endif %}
    {% endif %}

    <div class="product-simple__title">
        {% if link %}<a href="{{ link }}">{% endif %}
          {{ title }}
        {% if link %}</a>{% endif %}
    </div>

</div>
