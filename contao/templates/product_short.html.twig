{% use "@Contao/component/_figure.html.twig" %}

<div class="product-short {{ class }}">

    {% if figure %}
        {% if link %}<a href="{{ link }}">{% endif %}
        {% with {figure: figure} %}
            {{ block('figure_component') }}
        {% endwith %}
        {% if link %}</a>{% endif %}
    {% endif %}

    <div class="product-short__tags">
        {% if featured %}
            <div class="product-short__tag product-short__tag--featured"></div>
        {% endif %}

        {% if new_product is defined and new_product %}
            <div class="product-short__tag product-short__tag--new"></div>
        {% endif %}
    </div>

    <div class="product-short__title">
        {% if link %}<a href="{{ link }}">{% endif %}

        {{ title }}

        {% if link %}</a>{% endif %}
    </div>

    <div class="product-short__meta">
        <div class="product-short__info">
            <time datetime="{{ meta.datetime }}">{{ meta.date }}</time>

            {% if brand %}
                <span class="product-short__brand">
                    {{ brand_text }}:
                    <span>{{ brand }}</span>
                </span>
            {% endif %}

            {% if model %}
                <span class="product-short__model">
                    {{ model_text }}:
                    <span>{{ model }}</span>
                </span>
            {% endif %}

            {% if sku %}
                <span class="product-short__sku">
                    {{ sku_text }}:
                    <span>{{ sku }}</span>
                </span>
            {% endif %}

            {% if meta.global_ID is defined %}
                <span class="product-short__global-id {{ meta.global_ID.unit }}">
                    {{ meta.global_ID.name }}:
                    <span>{{ meta.global_ID.value }}</span>
                </span>
            {% endif %}
        </div>

        {% if url %}
            <div class="product-short__buy">
                <a href="{{ url|insert_tag }}"
                   class="product-short__buy-link"
                   title="{{ linkTitle }}"
                   {% if target %}target="_blank" rel="nofollow"{% endif %}>
                    {{ titleText ?: url|insert_tag }}
                </a>
            </div>
        {% endif %}
    </div>
</div>
