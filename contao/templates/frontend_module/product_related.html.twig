{% extends '@Contao/frontend_module/_base.html.twig' %}

{% block content %}

  {% if relateds is not empty %}
      <div class="related-products-list {{ data.product_listClass }}">
          {% for related in relateds %}
              <div class="related-products-list__item">{{ related|raw }}</div>
          {% endfor %}
      </div>
  {% endif %}

{% endblock %}
