{% extends '@Contao/frontend_module/_base.html.twig' %}

{% block content %}

    {% if products is empty %}
        <p class="product-list__empty">{{ empty }}</p>
    {% else %}
        <div class="product-list {{ data.product_listClass }}">
            {{ products|join|raw }}
        </div>

        {% if pagination is defined %}
            {{ pagination|raw }}
        {% endif %}
    {% endif %}

{% endblock %}
